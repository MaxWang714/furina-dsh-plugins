{
  "name": "vision-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Vision local LLM control plane with DSH observability and optional Codex integrations",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx apps/desktop/src/server.ts",
    "gateway": "tsx apps/desktop/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "frontend:dev": "vite --config apps/desktop/vite.config.ts",
    "frontend:build": "vite build --config apps/desktop/vite.config.ts",
    "replay": "tsx scripts/replay.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
